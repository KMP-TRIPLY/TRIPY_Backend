# application-local.yml 작성 예시
# 이 파일을 복사해서 application-local.yml 을 만들고 실제 값을 채워주세요
# application-local.yml 은 .gitignore 에 추가되어 있어 커밋되지 않습니다

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/triply
    username: postgres
    password: your_db_password

  security:
    oauth2:
      client:
        registration:
          kakao:
            client-id: your_kakao_client_id
            client-secret: your_kakao_client_secret

          naver:
            client-id: your_naver_client_id
            client-secret: your_naver_client_secret

          google:
            client-id: your_google_client_id
            client-secret: your_google_client_secret

jwt:
  secret: your_jwt_secret_base64_encoded

tourism:
  api:
    key: your_tourism_api_key

# 백제 역사 코스(스토리 A/B/C) 시드 데이터를 최초 1회 등록하려면 true로 설정 후 서버를 한 번 기동하세요.
# 이미 등록된 코스가 있으면 자동으로 건너뜁니다.
app:
  seed:
    enabled: true